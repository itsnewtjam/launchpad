<?xml version="1.0" encoding="utf-8"?>
<form>
  <field
    name="id"
    type="text"
    label="JGLOBAL_FIELD_ID"
    class="readonly"
    default="0"
    readonly="true"
  /> 
  <field
    name="title"
    type="text"
    label="COM_LAUNCHPAD_PAGE_TITLE"
    required="true"
  />
  <field
    name="header_image"
    type="media"
    label="COM_LAUNCHPAD_PAGE_HEADERIMAGE"
  />
  <field
    name="heading_use_title"
    type="radio"
    label="COM_LAUNCHPAD_PAGE_HEADINGUSETITLE"
    default="1"
    layout="joomla.form.field.radio.switcher"
  >
    <option value="0">JNo</option>
    <option value="1">JYes</option>
  </field>
  <field
    name="heading"
    type="text"
    label="COM_LAUNCHPAD_PAGE_HEADING"
    showon="heading_use_title:0"
  />
  <field
    name="description"
    type="editor"
    label="COM_LAUNCHPAD_PAGE_DESCRIPTION"
    filter="raw"
  />
  <field
    name="background_type"
    type="list"
    label="COM_LAUNCHPAD_PAGE_BACKGROUNDTYPE"
    default="image"
  >
    <option value="image">COM_LAUNCHPAD_PAGE_BACKGROUNDTYPE_IMAGE</option>
    <option value="css">COM_LAUNCHPAD_PAGE_BACKGROUNDTYPE_CSS</option>
  </field>
  <field
    name="background_css"
    type="text"
    label="COM_LAUNCHPAD_PAGE_BACKGROUNDCSS"
    description="COM_LAUNCHPAD_PAGE_BACKGROUNDCSS_DESC"
    showon="background_type:css"
  />
  <field
    name="background_image"
    type="media"
    label="COM_LAUNCHPAD_PAGE_BACKGROUNDIMAGE"
    showon="background_type:image"
  />
  <field
    name="links"
    type="subform"
    label="COM_LAUNCHPAD_PAGE_LINKS"
    multiple="true"
    layout="joomla.form.field.subform.repeatable-table"
  >
    <form>
      <field
        name="text"
        type="text"
        label="COM_LAUNCHPAD_PAGE_LINK_TEXT"
        required="true"
      />
      <field
        name="url"
        type="text"
        label="COM_LAUNCHPAD_PAGE_LINK_URL"
        required="true"
      />
      <field
        name="new_tab"
        type="radio"
        label="COM_LAUNCHPAD_PAGE_LINK_NEWTAB"
        default="0"
        layout="joomla.form.field.radio.switcher"
      >
        <option value="0">JNo</option>
        <option value="1">JYes</option>
      </field>
    </form>
  </field>
  <field
    name="css"
    type="editor"
    label="COM_LAUNCHPAD_PAGE_CSS"
    editor="codemirror|none"
    buttons="no"
    syntax="css"
    filter="raw"
  />
  <field
    name="published"
    type="list"
    label="JSTATUS"
    default="1"
    class="form-select-color-state"
    validate="options"
  >
    <option value="1">JPUBLISHED</option>
    <option value="0">JUNPUBLISHED</option>
    <option value="-2">JTRASHED</option>
  </field>
</form>
