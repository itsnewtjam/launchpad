{
  "pull-request-title-pattern": "chore: release ${version}",
  "extra-files": [
    {
      "type": "xml",
      "path": "launchpad.xml",
      "xpath": "//extension/version"
    },
    {
      "type": "xml",
      "path": "dist/update.xml",
      "xpath": "//updates/update/version"
    }
  ],
  "packages": {
    ".": {
      "release-type": "simple"
    }
  }
}
